# OCR Pipeline Configuration

# Claude API for text correction (Step 3)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-YOUR-KEY-HERE

# Google Cloud Vision API for OCR (Step 2)
# Alternative to Tesseract (requires API key)
# Get your API key from: https://cloud.google.com/vision
GOOGLE_CLOUD_API_KEY=your-api-key-here

# Tesseract OCR path (if not in system PATH)
# Example: /usr/bin/tesseract (macOS: /usr/local/bin/tesseract)
# Leave blank to use system default
TESSERACT_CMD=

# Optional: Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: Enable verbose output
VERBOSE=false
